# Canonical site URL (SEO: sitemap, robots, meta). No trailing slash.
PUBLIC_SITE_URL=http://localhost:5173

# Optional: footer “credit” link (both required for the link to show).
# PUBLIC_APP_CREDIT_URL=https://example.com
# PUBLIC_APP_CREDIT_LABEL=Your name or brand

# --- Optional: Sanity CMS (logo, colors, marketing copy). If unset, the app uses cv-messages JSON + default CSS only.
# https://www.sanity.io/ — see studio/README.md
# PUBLIC_SANITY_PROJECT_ID=yourProjectId
# PUBLIC_SANITY_DATASET=production
# PUBLIC_SANITY_API_VERSION=2024-01-01

# Only if the dataset is private (otherwise leave unset).
# SANITY_READ_TOKEN=
